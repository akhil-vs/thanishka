# PostgreSQL — from Vercel Marketplace → Prisma Postgres (or Neon / Supabase)
# Vercel usually injects this when you connect Storage → Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional aliases used by some Vercel Prisma integrations (build script falls back to these)
# PRISMA_DATABASE_URL=
# POSTGRES_URL=

# Session signing secrets — change in production / set in Vercel env
ADMIN_JWT_SECRET=thanishka-dev-admin-secret-change-me
STAFF_JWT_SECRET=thanishka-dev-staff-secret-change-me
CUSTOMER_JWT_SECRET=thanishka-dev-customer-secret-change-me

# OTP (customer). In non-production, codes are returned as devCode and logged.
# Set OTP_DEV_MODE=true to keep that behaviour in production staging.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456
OTP_PEPPER=thanishka-dev-otp-pepper-change-me

# Seeded on first `npm run db:seed` if no backoffice user exists
ADMIN_EMAIL=admin@thanishka.com
ADMIN_PASSWORD=thanishka-admin

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Key ID is returned to the browser from /api/checkout/create — keep secret server-side only.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional — webhook at /api/checkout/webhook (payment.captured)
RAZORPAY_WEBHOOK_SECRET=
# Force simulated prepaid checkout without calling Razorpay (local / staging only)
# RAZORPAY_DEV_MODE=true
