# PostgreSQL — from Vercel Marketplace → Prisma Postgres (or Neon / Supabase)
# Use the pooled URL for the app runtime when available.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Direct (non-pooled) URL for Prisma migrations. Mirror DATABASE_URL if you only have one.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Admin session signing secret — change in production / set in Vercel env
ADMIN_JWT_SECRET=thanishka-dev-admin-secret-change-me

# Seeded on first `npm run db:seed` if no admin exists
ADMIN_EMAIL=admin@thanishka.com
ADMIN_PASSWORD=thanishka-admin
